<?xml version="1.0" encoding="utf-8"?>
<!-- Layout follows the shipped Panels/CivicBoostsPanel.xml. -->
<Context Name="ChancellorAlerts" Style="FontNormal16" ColorSet="Beige_Black" FontStyle="Shadow">

  <Container ID="Panel" Anchor="R,T" Offset="12,110" Size="330,auto" ConsumeMouse="true" Hidden="1">
    <Grid ID="Frame" Size="parent,auto" Style="WindowFrameHUD" InnerPadding="20,20">
      <Stack ID="Body" Offset="16,14" StackGrowth="Bottom" StackPadding="6">
        <Container Size="298,22">
          <Label ID="Header" Anchor="L,C" Style="FontFlair16" Color="Culture" String="Vizier"/>
          <Button ID="Close" Anchor="R,C" Size="22,22" Style="CloseButtonSmall"/>
        </Container>
        <Stack ID="AlertStack" StackGrowth="Bottom" StackPadding="8"/>
      </Stack>
    </Grid>
  </Container>

  <Instance Name="AlertInstance">
    <Stack ID="Root" StackGrowth="Bottom" StackPadding="2">
      <Label ID="Title" Style="FontNormal16" WrapWidth="290"/>
      <Label ID="Detail" Style="FontNormal14" WrapWidth="290" Color="200,200,200,255"/>
    </Stack>
  </Instance>

</Context>
