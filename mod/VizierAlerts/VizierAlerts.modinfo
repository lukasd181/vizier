<?xml version="1.0" encoding="utf-8"?>
<Mod id="5d0f6a8e-3c1b-4f9e-9a52-7c2e4b1d8f30" version="1">
  <Properties>
    <Name>Vizier Alerts</Name>
    <Description>Shows the Vizier mentor's top 3 alerts in the game UI, so you don't have to alt-tab. Display only: it never changes the game.</Description>
    <Teaser>Vizier mentor alert panel.</Teaser>
    <Authors>vizier</Authors>
    <AffectsSavedGames>0</AffectsSavedGames>
    <CompatibleVersions>1.2,2.0</CompatibleVersions>
  </Properties>
  <InGameActions>
    <AddUserInterfaces id="VizierAlertsUI">
      <Properties>
        <Context>InGame</Context>
      </Properties>
      <File>UI/VizierAlerts.xml</File>
    </AddUserInterfaces>
    <ImportFiles id="VizierAlertsLua">
      <File>UI/VizierAlerts.lua</File>
    </ImportFiles>
  </InGameActions>
  <Files>
    <File>UI/VizierAlerts.xml</File>
    <File>UI/VizierAlerts.lua</File>
  </Files>
</Mod>
